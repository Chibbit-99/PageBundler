{
  "manifest_version": 3,
  "name": "PageBundler",
  "version": "1.0.0",
  "description": "Save a web page and its attached files into a ZIP archive.",
  "permissions": ["activeTab", "scripting", "downloads", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_title": "Save page as ZIP" },
  "background": { "service_worker": "background.js" }
}
